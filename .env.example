# ── Local development environment ──────────────────────────────────────────
# Copy this file to the project root (Author/.env) on your machine.
# Docker Compose loads it automatically.

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql+asyncpg://aip:aip@postgres:5432/aip

# Redis (matches docker-compose.yml redis service)
REDIS_URL=redis://redis:6379/0

# JWT signing key — fine for local dev, MUST be changed in production
SECRET_KEY=local-dev-secret-key-change-in-production

# App environment — keeps auth bypass active (no login required locally)
ENVIRONMENT=development

# ── AI providers (fill in whichever you have) ──────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── Ollama (local AI — host.docker.internal lets the container reach your Mac)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Storage (MinIO — matches docker-compose.yml minio service) ──────────────
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=aip-assets

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
