# Copy this to .env and fill in your real values
# Run: cp .env.local.example .env

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-replace-with-openssl-rand-hex-32

# AI provider — at least one required (DeepSeek is cheapest)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# These are set automatically by docker-compose — do not change
# DATABASE_URL, REDIS_URL, AWS_* are overridden per-service in docker-compose.yml
